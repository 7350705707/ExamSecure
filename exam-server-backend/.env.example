HOST=0.0.0.0
PORT=8001
DEBUG=false

# Comma-separated intranet origins allowed for CORS
CORS_ORIGINS=http://localhost:5174,http://localhost:8001

# JWT — leave blank to auto-generate on first run
JWT_SECRET=
JWT_EXPIRE_HOURS=12

# LM Studio endpoint for short-answer grading
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen2.5-7b-instruct-1m

# Database (SQLite path)
DATABASE_PATH=./exam.db

# Fuzzy match threshold for fill-in-the-blank (0-100)
FUZZY_THRESHOLD=80
