{
  "name": "exam-browser-client",
  "version": "1.0.0",
  "description": "Locked-down Electron exam browser",
  "author": "ExamServer",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:win:portable": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.examserver.browser",
    "productName": "ExamBrowser",
    "forceCodeSigning": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        { "target": "portable" },
        { "target": "nsis" }
      ],
      "icon": "assets/icon.ico",
      "signingHashAlgorithms": null
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": ".env", "to": ".env" }
    ]
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  }
}
